---
/**
 * /line-up — vollständige Act-Liste.
 *
 * Acts mit Profil (Bild/Bio/Links) als Konzept-2-Karten (StarCornerImage:
 * rechteckiges, gut lesbares Bild + solider Stern in der Ecke). Darunter das
 * restliche Programm nach Bühne — so ist die volle Besetzung sichtbar, ohne
 * fehlende Bios/Genres zu erfinden.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
import StarCornerImage from '@ui/StarCornerImage.astro';
import { acts } from '@content/acts';
import type { StarShape, StarAccent } from '@lib/sterne';

type Corner = 'tl' | 'tr' | 'bl' | 'br';
const layouts: { shape: StarShape; accent: StarAccent; corner: Corner }[] = [
  { shape: '2', accent: 'pink', corner: 'tr' },
  { shape: '3', accent: 'green', corner: 'br' },
  { shape: '1', accent: 'green', corner: 'bl' },
  { shape: '4', accent: 'pink', corner: 'tl' },
];

// Restliches Programm (ohne die Acts mit eigenem Profil oben), nach Bühne.
const weitere: { stage: string; names: string[] }[] = [
  {
    stage: 'Kieselwiese · Live',
    names: ['Bärte mit Mädchen', 'Beste & Liv', 'FLouSe', 'Ideer'],
  },
  {
    stage: 'Maschinerie · DJs',
    names: [
      'Scherwin Hosseini b2b Alias Shay',
      'Floppy b2b Corti',
      'Shaxtar & Kisya',
      'canê b2b Schrotflinta',
      'lil apple (Anni mit K)',
    ],
  },
];
---

<BaseLayout
  title="Line-Up"
  description="Das Line-Up des flinta*sialand 2026 — Live-Acts und DJs auf zwei Bühnen im Speicher 100, Dortmund."
>
  <Section theme="light" spacing="lg" class="pt-28 md:pt-32">
    <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
      Line-Up 2026
    </p>
    <Heading level={1} size="lg" class="mt-3">Wer spielt beim flinta*sialand</Heading>
    <p class="mt-4 max-w-2xl text-on-surface-muted">
      Von treibenden Live-Performances bis zu tiefen elektronischen DJ-Sets — auf
      zwei Bühnen im Speicher 100. Erste Künstler*innen im Detail:
    </p>

    <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2">
      {
        acts.map((act, i) => {
          const l = layouts[i % layouts.length];
          return (
            <article class="flex flex-col">
              <StarCornerImage
                src={act.image}
                alt={`${act.name} — Portrait`}
                ratio="4 / 5"
                shape={l.shape}
                accent={l.accent}
                corner={l.corner}
              />
              <div class="mt-5">
                <h2 class="font-display text-2xl font-bold tracking-tight">
                  {act.name}
                </h2>
                <p class="mt-1 text-sm font-medium uppercase tracking-wider text-accent">
                  {act.genre}
                </p>
                <p class="mt-3 text-on-surface-muted">{act.bio}</p>
                {act.links.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {act.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex rounded-full px-3 py-1 text-sm font-bold text-accent ring-1 ring-hairline transition-colors hover:bg-accent hover:text-accent-on"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </Section>

  <!-- Restliches Programm -->
  <Section theme="dark" spacing="lg">
    <Heading level={2} size="md">Das komplette Programm</Heading>
    <p class="mt-3 max-w-2xl text-on-surface-muted">
      Weitere Acts – die Zeiten stehen in der Timetable.
    </p>
    <div class="mt-8 grid gap-8 md:grid-cols-2">
      {
        weitere.map((group) => (
          <div>
            <h3 class="font-display text-lg font-bold text-accent">{group.stage}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.names.map((name) => (
                <li class="rounded-full bg-mint/10 px-4 py-2 font-display font-bold ring-1 ring-mint/15">
                  {name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-12">
      <Button href="/timetable" variant="outline">Zur Timetable</Button>
    </div>
  </Section>
</BaseLayout>
