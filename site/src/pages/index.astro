---
/**
 * Startseite — PHASE 1: Verifikationsstand.
 *
 * Zeigt Basis-Layout, Navbar/Footer und die Theme-Zonen (dark/light) mit den
 * CI-Akzentfarben. Der echte Hero (Video + wabernde Logo-Ebene) und die
 * Teaser-Sektionen kommen in Phase 3/4 und ersetzen den Platzhalter unten.
 */
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
import StarMaskedImage from '@ui/StarMaskedImage.astro';
import StarCornerImage from '@ui/StarCornerImage.astro';
import logoMint from '@assets/logo/logo-light-mint.svg';
import datumBerry from '@assets/brand/datum-berry.svg';
import texBlau from '@assets/demo/tex-blau.jpg';
import texPink from '@assets/demo/tex-pink.jpg';
import texGruen from '@assets/demo/tex-gruen.jpg';
---

<BaseLayout title="Festival">
  <!-- HERO-PLATZHALTER (dark) — echter Video-Hero folgt in Phase 3 -->
  <Section theme="dark" spacing="none" container={false}>
    <div
      class="relative flex min-h-[70vh] flex-col items-center justify-center overflow-hidden px-6 py-24 text-center"
    >
      <Image
        src={logoMint}
        alt="Flinta*sialand"
        class="w-full max-w-2xl"
        loading="eager"
      />
      <Image src={datumBerry} alt="" class="mt-8 w-full max-w-md opacity-90" />
      <p class="mt-6 max-w-md text-on-surface-muted">
        Platzhalter-Hero (Phase 1). In Phase 3 folgt hier das
        Genderstern-Animationsvideo mit wabernder, maus-reaktiver Logo-Ebene.
      </p>
    </div>
  </Section>

  <!-- INTRO (light) -->
  <Section theme="light" id="intro">
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div>
        <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
          Was ist Flinta*sialand?
        </p>
        <Heading level={2} class="mt-3">
          Ein Festival als sicherer Raum — von und für FLINTA*.
        </Heading>
        <p class="mt-5 max-w-prose text-on-surface-muted">
          Platzhalter-Text. Musik, Awareness und Community stehen im Zentrum.
          Die Inhalte kommen später über das CMS und lassen sich von Laien
          pflegen, ohne das Design zu brechen.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href="/line-up">Line-Up entdecken</Button>
          <Button href="/awareness" variant="outline">Awareness-Konzept</Button>
        </div>
      </div>
      <div class="grid grid-cols-2 items-center gap-4">
        <StarMaskedImage src={texGruen} alt="" shape="1" accent="green" />
        <StarMaskedImage
          src={texPink}
          alt=""
          shape="4"
          accent="pink"
          class="mt-8"
        />
      </div>
    </div>
  </Section>

  <!-- PHASE-2-DEMO: Stern-/Bild-Komponenten -->
  <Section theme="dark" id="stern-demo">
    <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
      Phase 2 — Stern-Bild-Komponenten
    </p>
    <Heading level={2} class="mt-3">Konzept 1: Bild sitzt im Stern</Heading>
    <p class="mt-3 max-w-prose text-on-surface-muted">
      <code>&lt;StarMaskedImage&gt;</code> — Bild in Genderstern-Silhouette geclippt,
      mit leichtem Akzent-Overlay (multiply). Sternform und Akzentfarbe frei
      wählbar; verschiedene Sterne tragen verschiedene Akzente.
    </p>
    <div class="mt-8 grid grid-cols-2 gap-5 sm:grid-cols-4">
      <StarMaskedImage src={texBlau} alt="" shape="1" accent="teal" />
      <StarMaskedImage src={texPink} alt="" shape="2" accent="pink" />
      <StarMaskedImage src={texGruen} alt="" shape="3" accent="teal" />
      <StarMaskedImage src={texBlau} alt="" shape="4" accent="pink" />
    </div>
  </Section>

  <Section theme="light">
    <Heading level={2}>Konzept 2: Quadrat mit Stern-Ecke</Heading>
    <p class="mt-3 max-w-prose text-on-surface-muted">
      <code>&lt;StarCornerImage&gt;</code> — rechteckiges Bild (beste Lesbarkeit
      für Grids wie Line-Up/News), an einer Ecke ein solider Stern in Akzentfarbe,
      der leicht über die Kante lappt. Ecke, Form und Akzent wählbar.
    </p>
    <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
      <StarCornerImage src={texGruen} alt="" corner="tr" shape="2" accent="pink" />
      <StarCornerImage src={texBlau} alt="" corner="br" shape="3" accent="green" />
      <StarCornerImage src={texPink} alt="" corner="bl" shape="1" accent="green" />
      <StarCornerImage src={texGruen} alt="" corner="tl" shape="4" accent="pink" />
    </div>
  </Section>

  <!-- THEME-DEMO (dark) — belegt die Zonen-Umschaltung + Akzentfarben -->
  <Section theme="dark">
    <Heading level={2}>Theme-Demo: dark-Zone</Heading>
    <p class="mt-3 max-w-prose text-on-surface-muted">
      Diese Sektion trägt <code>data-theme="dark"</code>: Hintergrund berry,
      Text mint, UI-Akzent teal. Buttons und Links ziehen den Akzent automatisch.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="#">Solid-Button (teal)</Button>
      <Button href="#" variant="outline">Outline-Button</Button>
    </div>

    <!-- Farb-Swatches zur CI-Kontrolle -->
    <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-5">
      <div class="rounded-md bg-berry p-4 text-mint ring-1 ring-hairline">berry</div>
      <div class="rounded-md bg-mint p-4 text-berry">mint</div>
      <div class="rounded-md bg-accent-teal p-4 text-berry">teal</div>
      <div class="rounded-md bg-accent-green p-4 text-mint">green</div>
      <div class="rounded-md bg-accent-pink p-4 text-berry">pink</div>
    </div>
  </Section>

  <!-- THEME-DEMO (light) -->
  <Section theme="light">
    <Heading level={2}>Theme-Demo: light-Zone</Heading>
    <p class="mt-3 max-w-prose text-on-surface-muted">
      Gleiche Komponenten, <code>data-theme="light"</code>: Hintergrund mint,
      Text berry, UI-Akzent green — ohne dass die Komponenten die Zone kennen.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="#">Solid-Button (green)</Button>
      <Button href="#" variant="outline">Outline-Button</Button>
    </div>
  </Section>
</BaseLayout>
