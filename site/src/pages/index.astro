---
/**
 * Startseite — One-Pager (Phase 4).
 *
 * Vollwertiger One-Pager mit Hero, Intro, Line-Up-Teaser, Timetable-Teaser,
 * Lageplan-Teaser, Awareness-Teaser und Förderer-Logoleiste. Die Teaser-
 * Sektionen verlinken auf die jeweiligen Detail-Routen.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/hero/Hero.astro';
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
import StarMaskedImage from '@ui/StarMaskedImage.astro';
import LineupTeaser from '@blocks/LineupTeaser.astro';
import TimetableTeaser from '@blocks/TimetableTeaser.astro';
import LageplanTeaser from '@blocks/LageplanTeaser.astro';
import AwarenessTeaser from '@blocks/AwarenessTeaser.astro';
import FoerdererBlock from '@blocks/FoerdererBlock.astro';

import texGruen from '@assets/demo/tex-gruen.jpg';
import texPink from '@assets/demo/tex-pink.jpg';
---

<BaseLayout title="Festival">
  <!-- 1. HERO (dark) — Video-Hintergrund + wabernde, maus-reaktive Logo-Ebene + Datum -->
  <Hero variant="video" scrollTo="#intro" />

  <!-- 2. INTRO (light) — Was ist Flinta*sialand? -->
  <Section theme="light" id="intro">
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div>
        <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
          Was ist Flinta*sialand?
        </p>
        <Heading level={2} class="mt-3">
          Ein Festival als sicherer Raum — von und für FLINTA*.
        </Heading>
        <p class="mt-5 max-w-prose text-on-surface-muted">
          Flinta*sialand ist ein Tagesfestival für Sichtbarkeit und Empowerment
          von FLINTA*-Künstler*innen. Musik, Awareness und Community stehen im
          Zentrum — in einem safer space, der Platz für alle schafft.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href="/line-up">Line-Up entdecken</Button>
          <Button href="/awareness" variant="outline">Awareness-Konzept</Button>
        </div>
      </div>
      <div class="grid grid-cols-2 items-center gap-4">
        <StarMaskedImage src={texGruen} alt="" shape="1" accent="green" />
        <StarMaskedImage
          src={texPink}
          alt=""
          shape="4"
          accent="pink"
          class="mt-8"
        />
      </div>
    </div>
  </Section>

  <!-- 3. LINE-UP-TEASER (dark) -->
  <LineupTeaser />

  <!-- 4. TIMETABLE-TEASER (light) -->
  <TimetableTeaser />

  <!-- 5. LAGEPLAN-TEASER (light) -->
  <LageplanTeaser />

  <!-- 6. AWARENESS-TEASER (dark) -->
  <AwarenessTeaser />

  <!-- 7. FÖRDERER (light) -->
  <FoerdererBlock />
</BaseLayout>
