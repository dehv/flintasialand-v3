---
/**
 * /workshops — Community Space: Workshops, Gewalten Formen & Queer Dating Stage.
 *
 * Aufbau: Intro zum Community Space → Workshop-Grid (analog Line-Up) →
 * Abschnitt „Gewalten Formen“ (Installation/Zone) → „Queer Dating Stage“.
 * Workshops mit Foto bekommen den Genderstern-Eckrahmen (wie Acts), ohne Foto
 * eine Text-Karte mit Genderstern-Akzent. Inhalte: content/workshops.ts.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import StarCornerImage from '@ui/StarCornerImage.astro';
import StarBullet from '@ui/StarBullet.astro';
import { workshops } from '@content/workshops';
import type { StarShape, StarAccent } from '@lib/sterne';
import imgGewaltenFormen from '@assets/workshops/gewalten-formen.png';
import { texte, pick } from '@content/texte';
import { localeFromPath } from '@lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = texte.workshops;
const cs = texte.common.communitySpace;

/**
 * Reihenfolge fürs 2-Spalten-Grid: erst alle Workshops MIT Foto (hohe Karten),
 * dann die Textkarten — je Gruppe chronologisch. So bleiben die Spalten
 * gleichmäßig hoch und lesbar, statt dass sich hohe und flache Karten
 * abwechseln. Workshops ohne Uhrzeit landen am Ende ihrer Gruppe.
 */
const startMin = (time?: string): number => {
  if (!time) return 24 * 60;
  const m = time.match(/(\d{1,2}):(\d{2})/);
  return m ? Number(m[1]) * 60 + Number(m[2]) : 24 * 60;
};
const orderedWorkshops = [...workshops].sort((a, b) => {
  const aHasImg = a.image ? 0 : 1;
  const bHasImg = b.image ? 0 : 1;
  if (aHasImg !== bHasImg) return aHasImg - bHasImg;
  return startMin(a.time) - startMin(b.time);
});

type Corner = 'tl' | 'tr' | 'bl' | 'br';
const layouts: { shape: StarShape; accent: StarAccent; corner: Corner }[] = [
  { shape: '2', accent: 'pink', corner: 'tr' },
  { shape: '3', accent: 'green', corner: 'br' },
  { shape: '1', accent: 'green', corner: 'bl' },
  { shape: '4', accent: 'pink', corner: 'tl' },
];
---

<BaseLayout
  title={pick(t.metaTitle, locale)}
  description={pick(t.metaDescription, locale)}
>
  <Section theme="light" spacing="lg" class="pt-28 md:pt-32">
    <Heading level={1} size="lg" class="mt-3">{pick(t.headline, locale)}</Heading>
    <p class="mt-4 max-w-2xl text-on-surface-muted" set:html={pick(t.intro, locale)} />

    <Heading level={2} size="md" class="mt-14">{pick(t.workshopsHeading, locale)}</Heading>

    <div class="mt-8 grid gap-x-8 gap-y-12 sm:grid-cols-2">
      {
        orderedWorkshops.map((ws, i) => {
          const l = layouts[i % layouts.length];
          return (
            <article class="flex flex-col">
              {ws.image ? (
                <div>
                  <StarCornerImage
                    src={ws.image}
                    alt={`${ws.title} — Workshop`}
                    ratio="4 / 5"
                    shape={ws.shape ?? l.shape}
                    accent={l.accent}
                    corner={l.corner}
                    focus={ws.focus}
                    zoom={ws.zoom}
                  />
                  {ws.credit && (
                    <p class="mt-2 text-xs text-on-surface-muted">{ws.credit}</p>
                  )}
                </div>
              ) : (
                <div class="flex items-center gap-3 rounded-2xl bg-surface-muted/50 px-5 py-4 ring-1 ring-hairline">
                  <StarBullet shape={ws.shape ?? l.shape} accent={l.accent} size="1.6rem" />
                  <span class="font-display text-sm font-bold uppercase tracking-wider text-accent">
                    {pick(cs, locale)}
                  </span>
                </div>
              )}

              <div class="mt-5">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-display text-2xl font-bold tracking-tight">
                    {ws.title}
                  </h3>
                  {ws.tba && (
                    <span class="rounded-full bg-surface-muted/70 px-2.5 py-0.5 font-display text-xs font-bold uppercase tracking-wider text-on-surface-muted ring-1 ring-hairline">
                      {pick(texte.common.infosFolgen, locale)}
                    </span>
                  )}
                </div>
                {ws.facilitator && (
                  <p class="mt-1 text-sm font-medium uppercase tracking-wider text-accent">
                    {ws.facilitator}
                  </p>
                )}
                <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold text-on-surface-muted">
                  {ws.location && <span>{ws.location}</span>}
                  {ws.location && ws.time && <span aria-hidden="true">·</span>}
                  {ws.time && (
                    <span class="font-mono tracking-tight text-accent">{ws.time}</span>
                  )}
                </p>
                <p class="mt-3 text-on-surface-muted">
                  {locale === 'en' ? (ws.descriptionEn ?? ws.description) : ws.description}
                </p>
              </div>
            </article>
          );
        })
      }
    </div>
  </Section>

  {/* Gewalten Formen — künstlerisch-politische Installation/Zone */}
  <Section theme="dark" spacing="lg">
    <div class="grid items-center gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <div class="flex items-center gap-3">
          <StarBullet shape="4" accent="pink" size="1.6rem" />
        </div>
        <Heading level={2} size="md" class="mt-3">{pick(t.gewalten.heading, locale)}</Heading>
        <p class="mt-4 max-w-2xl text-on-surface-muted" set:html={pick(t.gewalten.p1, locale)} />
        <p class="mt-4 max-w-2xl text-on-surface-muted" set:html={pick(t.gewalten.p2, locale)} />
      </div>
      <div class="md:col-span-5">
        <StarCornerImage
          src={imgGewaltenFormen}
          alt="„Gewalten Formen“ — Konzept der mobilen, künstlerisch-politischen Installation"
          ratio="4 / 5"
          shape="1"
          accent="green"
          corner="tr"
          focus="50% 45%"
        />
        <p class="mt-3 text-xs text-on-surface-muted">
          {pick(t.gewalten.credit, locale)}
        </p>
      </div>
    </div>
  </Section>

  {/* Queer Dating Stage */}
  <Section theme="light" spacing="lg" class="border-t border-hairline">
    <div class="flex items-center gap-3">
      <StarBullet shape="2" accent="pink" size="1.6rem" />
    </div>
    <Heading level={2} size="md" class="mt-3">{pick(t.queer.heading, locale)}</Heading>
    <p class="mt-4 max-w-2xl text-on-surface-muted">
      {pick(t.queer.body, locale)}
    </p>
    <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-surface-muted/70 px-4 py-1.5 font-display text-xs font-bold uppercase tracking-wider text-on-surface-muted ring-1 ring-hairline">
      {pick(texte.common.infosFolgen, locale)}
    </p>
  </Section>
</BaseLayout>
