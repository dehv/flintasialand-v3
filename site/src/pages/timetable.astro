---
/**
 * /timetable — vollständige Timetable auf der Seite + PDF-Download.
 *
 * Responsiv: Desktop zwei Bühnenspalten nebeneinander, mobil gestapelt.
 * Eintägiges Festival -> keine Tages-Tabs nötig. Daten aus dem Content-Layer.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
import { timetable } from '@content/timetable';

const pdfHref = '/downloads/timetable-flintasialand-2026.pdf';
---

<BaseLayout
  title="Timetable"
  description="Die vollständige Timetable des flinta*sialand 2026 — zwei Bühnen, ein Tag. Zum Nachlesen und als PDF-Download."
>
  <Section theme="light" spacing="lg" class="pt-28 md:pt-32">
    <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
      Timetable
    </p>
    <Heading level={1} size="lg" class="mt-3">Wann läuft was?</Heading>
    <p class="mt-4 max-w-2xl text-on-surface-muted">
      Samstag, 15. August 2026 · Speicher 100, Dortmunder Hafen. Zwei Bühnen,
      ein Tag — hier der komplette Ablauf. Änderungen vorbehalten.
    </p>
    <div class="mt-8">
      <Button href={pdfHref} download>Timetable als PDF</Button>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {
        timetable.map((stage) => (
          <div class="rounded-2xl bg-surface-muted/50 p-6 ring-1 ring-hairline md:p-8">
            <h2 class="border-b border-hairline pb-4 font-display text-xl font-bold tracking-tight text-accent">
              {stage.stageName}
            </h2>
            <ul class="mt-4 divide-y divide-hairline">
              {stage.slots.map((slot) => (
                <li class="flex items-baseline justify-between gap-4 py-3">
                  <span class="shrink-0 font-mono text-sm font-semibold tracking-tight text-accent">
                    {slot.time}
                  </span>
                  <span class="text-right font-display font-bold text-on-surface">
                    {slot.artist}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>
</BaseLayout>
