---
/**
 * /awareness — Awareness-Konzept.
 *
 * Baut auf dem realen Awareness-/CoC-Inhalt auf: Safer Space, Awareness-Team
 * (pinke Westen), pinke Bänder gegen ungewollte Fotos, Rückzug, Pronomen,
 * Kontakt. Verlinkt auf den vollständigen Code of Conduct.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
import StarBullet from '@ui/StarBullet.astro';
import { texte, pick } from '@content/texte';
import { localeFromPath } from '@lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = texte.awareness;
const grundsatzShapes = ['1', '2', '3', '4'] as const;
---

<BaseLayout
  title={pick(t.metaTitle, locale)}
  description={pick(t.metaDescription, locale)}
  brandOnDark
>
  <Section theme="dark" spacing="lg" class="pt-28 md:pt-32">
    <div class="mx-auto max-w-3xl">
      <Heading level={1} size="lg" class="mt-3">{pick(t.headline, locale)}</Heading>
      <p class="mt-5 text-lg text-on-surface-muted" set:html={pick(t.intro, locale)} />

      <!-- Direkter Draht zum Awareness-Team — bewusst ganz oben. -->
      <div
        class="mt-8 flex flex-col gap-3 rounded-2xl bg-mint/10 p-5 ring-1 ring-mint/15 sm:flex-row sm:items-center sm:justify-between sm:gap-6"
      >
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-display text-lg font-bold">
          <a
            href="tel:+4915755885086"
            class="text-accent underline underline-offset-2">01575 5885086</a
          >
          <span class="text-on-surface-muted" aria-hidden="true">·</span>
          <a
            href="mailto:support@aware-nrw.com"
            class="text-accent underline underline-offset-2">support@aware-nrw.com</a
          >
        </p>
      </div>
    </div>
  </Section>

  <!-- Grundsätze -->
  <Section theme="light" spacing="lg">
    <div class="mx-auto max-w-3xl">
      <Heading level={2} size="md">{pick(t.grundsaetzeHeading, locale)}</Heading>
      <ul class="mt-6 space-y-3 text-lg">
        {
          t.grundsaetze.map((g, i) => (
            <li class="flex items-start gap-3">
              <StarBullet shape={grundsatzShapes[i % grundsatzShapes.length]} size="1.15rem" class="mt-1" />
              {pick(g, locale)}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Angebote vor Ort -->
  <Section theme="light" spacing="lg" class="border-t border-hairline">
    <Heading level={2} size="md">{pick(t.vorOrtHeading, locale)}</Heading>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        t.angebote.map((a) => (
          <div class="rounded-2xl bg-surface-muted/60 p-6 ring-1 ring-hairline">
            <h3 class="font-display text-lg font-bold text-accent">{pick(a.title, locale)}</h3>
            <p class="mt-2 text-on-surface-muted">{pick(a.text, locale)}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Team-Kontakt + CoC-Verweis -->
  <Section theme="dark" spacing="lg">
    <div class="mx-auto max-w-3xl">
      <Heading level={2} size="md">{pick(t.teamHeading, locale)}</Heading>
      <p class="mt-5 text-on-surface-muted">{pick(t.teamBody, locale)}</p>
      <p class="mt-6 font-display text-lg font-bold">
        <a href="tel:+4915755885086" class="text-accent underline underline-offset-2"
          >01575 5885086</a
        >
        <span class="text-on-surface-muted"> · </span>
        <a
          href="mailto:support@aware-nrw.com"
          class="text-accent underline underline-offset-2">support@aware-nrw.com</a
        >
      </p>
      <div class="mt-8">
        <Button href="/code-of-conduct" variant="outline">
          {pick(t.cocButton, locale)}
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
