---
/**
 * /awareness — Awareness-Konzept.
 *
 * Baut auf dem realen Awareness-/CoC-Inhalt auf: Safer Space, Awareness-Team
 * (pinke Westen), pinke Bänder gegen ungewollte Fotos, Rückzug, Pronomen,
 * Kontakt. Verlinkt auf den vollständigen Code of Conduct.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';

const angebote: { title: string; text: string }[] = [
  {
    title: 'Awareness-Team vor Ort',
    text: 'Den ganzen Tag und Abend ansprechbar — erkennbar an den pinken Westen mit der Aufschrift „Awareness“. Parteilich, unterstützend und vertraulich.',
  },
  {
    title: 'Rückzugsraum',
    text: 'Ein ruhiger Ort zum Durchatmen, wenn dir alles zu viel wird. Du brauchst keinen Grund zu nennen.',
  },
  {
    title: 'Pronomen-Sticker',
    text: 'Am Eingang verfügbar. Du entscheidest selbst, wie du angesprochen werden möchtest.',
  },
  {
    title: 'Pinke Bänder gegen Fotos',
    text: 'Wer nicht fotografiert werden möchte, nimmt sich am Eingang ein pinkes Band. Bitte respektiere das — und frage grundsätzlich vor jedem Foto.',
  },
];
---

<BaseLayout
  title="Awareness"
  description="Das Awareness-Konzept des flinta*sialand: Safer Space, Awareness-Team, Rückzugsraum und klare Haltung gegen Diskriminierung."
>
  <Section theme="dark" spacing="lg" class="pt-28 md:pt-32">
    <div class="mx-auto max-w-3xl">
      <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
        Awareness & Sicherer Raum
      </p>
      <Heading level={1} size="lg" class="mt-3">Hier bist du sicher.</Heading>
      <p class="mt-5 text-lg text-on-surface-muted">
        Das flinta*sialand ist ein <strong class="text-on-surface">safer space</strong>
        für alle FLINTA*-Personen. Wir stehen für eine
        <strong class="text-on-surface">Zero-Tolerance-Politik</strong> gegenüber
        Diskriminierung, Grenzüberschreitungen und jeder Form von Gewalt. Dein
        Wohlbefinden steht im Zentrum.
      </p>
    </div>
  </Section>

  <!-- Grundsätze -->
  <Section theme="light" spacing="lg">
    <div class="mx-auto max-w-3xl">
      <Heading level={2} size="md">Awareness heißt für uns</Heading>
      <ul class="mt-6 space-y-3 text-lg">
        <li class="flex items-start gap-3">
          <span class="mt-1.5 h-3 w-3 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          Wir achten aufeinander. Wir hören zu.
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1.5 h-3 w-3 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          Wir respektieren Grenzen.
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1.5 h-3 w-3 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          Wir unterstützen, wenn sich jemand unwohl fühlt.
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1.5 h-3 w-3 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          Wir alle tragen Verantwortung füreinander.
        </li>
      </ul>
    </div>
  </Section>

  <!-- Angebote vor Ort -->
  <Section theme="light" spacing="lg" class="border-t border-hairline">
    <Heading level={2} size="md">Awareness vor Ort</Heading>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        angebote.map((a) => (
          <div class="rounded-2xl bg-surface-muted/60 p-6 ring-1 ring-hairline">
            <h3 class="font-display text-lg font-bold text-accent">{a.title}</h3>
            <p class="mt-2 text-on-surface-muted">{a.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Team-Kontakt + CoC-Verweis -->
  <Section theme="dark" spacing="lg">
    <div class="mx-auto max-w-3xl">
      <Heading level={2} size="md">Das Awareness-Team ist für dich da</Heading>
      <p class="mt-5 text-on-surface-muted">
        Wenn du dich nicht sicher fühlst oder etwas erlebst, das unseren
        Grundsätzen widerspricht: Melde dich. Du entscheidest, was du erzählen
        möchtest und welche Unterstützung du annimmst. Wir hören zu, stellen
        deine Wahrnehmung nicht in Frage und behandeln alles vertraulich.
      </p>
      <p class="mt-6 font-display text-lg font-bold">
        <a href="tel:+4915755885086" class="text-accent underline underline-offset-2"
          >01575 5885086</a
        >
        <span class="text-on-surface-muted"> · </span>
        <a
          href="mailto:support@aware-nrw.com"
          class="text-accent underline underline-offset-2">support@aware-nrw.com</a
        >
      </p>
      <div class="mt-8">
        <Button href="/code-of-conduct" variant="outline">
          Zum vollständigen Code of Conduct
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
