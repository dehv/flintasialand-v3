---
/**
 * 404 — Fallback für nicht gefundene Routen.
 *
 * Astro rendert src/pages/404.astro automatisch für unbekannte Pfade
 * (im Dev-Server sowie bei statischen Hosts wie GitHub Pages, die 404.html
 * ausliefern). Bewusst schlicht: klare Ansage + Weg zurück zur Startseite.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Diese Seite gibt es leider nicht (mehr)."
>
  <Section theme="light" spacing="lg" class="pt-28 md:pt-32">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
        Fehler 404
      </p>
      <Heading level={1} size="lg" class="mt-3">Hier ist nichts los</Heading>
      <p class="mt-5 text-on-surface-muted">
        Die Seite, die du suchst, gibt es leider nicht (mehr). Vielleicht hat
        sich ein Tippfehler eingeschlichen oder der Link ist veraltet.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <Button href="/">Zur Startseite</Button>
        <Button href="/line-up" variant="outline">Zum Line-Up</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
