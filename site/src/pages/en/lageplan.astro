---
/**
 * /lageplan — interaktive Karte (MapBlock-Island) + Anreise/Barrierefreiheit.
 * Deep-Link-fähige eigene Route (Phase 5).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import MapBlock from '@blocks/MapBlock.astro';
import { lageplan } from '@content/lageplan';
import { texte, pick } from '@content/texte';
import { localeFromPath } from '@lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = texte.lageplan;

const mapsHref = `https://www.openstreetmap.org/?mlat=${lageplan.center.lat}&mlon=${lageplan.center.lng}#map=17/${lageplan.center.lat}/${lageplan.center.lng}`;

// Karten-Tipp: {osm} wird durch den OpenStreetMap-Link ersetzt.
const [mapTipBefore, mapTipAfter] = pick(t.mapTip, locale).split('{osm}');

// Anreise-Texte je Sprache (Fallback auf Deutsch).
const anreise =
  locale === 'en' && lageplan.anreiseEn ? lageplan.anreiseEn : lageplan.anreise;
---

<BaseLayout
  title="Lageplan"
  description={`Lageplan & Anreise — ${lageplan.name}, ${lageplan.address}.`}
>
  <!-- Extra pt: die Navbar floatet fixed über dem Seitenanfang. -->
  <Section theme="light" spacing="lg" class="pt-28 md:pt-32">
    <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
      {pick(t.kicker, locale)}
    </p>
    <Heading level={1} size="lg" class="mt-3">{lageplan.name}</Heading>
    <p class="mt-3 text-on-surface-muted">
      {lageplan.address} · {lageplan.area}
    </p>

    <div class="mt-8">
      <MapBlock
        center={lageplan.center}
        zoom={lageplan.zoom}
        pins={lageplan.pins}
      />
    </div>

    <p class="mt-4 text-sm text-on-surface-muted">
      {mapTipBefore}
      <a
        href={mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-accent underline underline-offset-2"
      >
        {pick(t.openOsm, locale)}
      </a>
      {mapTipAfter}
    </p>
  </Section>

  <!-- Anreise / Barrierefreiheit -->
  <Section theme="dark" spacing="lg">
    <Heading level={2} size="md">{pick(t.anreiseHeading, locale)}</Heading>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      <div>
        <h3 class="font-display text-lg font-bold text-accent">{pick(t.oepnvLabel, locale)}</h3>
        <p class="mt-2 text-on-surface-muted">{anreise.oepnv}</p>
      </div>
      <div>
        <h3 class="font-display text-lg font-bold text-accent">{pick(t.autoLabel, locale)}</h3>
        <p class="mt-2 text-on-surface-muted">{anreise.auto}</p>
      </div>
      <div>
        <h3 class="font-display text-lg font-bold text-accent">{pick(t.barrierefreiheitLabel, locale)}</h3>
        <p class="mt-2 text-on-surface-muted">
          {anreise.barrierefreiheit}
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>
