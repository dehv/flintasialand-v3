---
/**
 * /tools/faces — DEV-Tool zum Positionieren & Zoomen der Act-Fotos.
 *
 * NICHT für Produktion gedacht (kein Nav/Footer, keine i18n). Zeigt jedes
 * Act-Foto in derselben Darstellung wie auf der Line-Up-Seite. Per Ziehen im
 * Bild setzt du den Ausschnitt (focus / object-position), per Slider den Zoom.
 * Unten bekommst du den fertigen Code-Schnipsel für `content/acts.ts`.
 *
 * Aufruf: `npm --prefix site run dev` → http://localhost:4321/tools/faces
 */
import type { ImageMetadata } from 'astro';
import { acts } from '@content/acts';
import { STAR_SHAPES, STAR_SHAPE_KEYS, type StarShape } from '@lib/sterne';

// Alle verfügbaren Artist-Fotos (für die Foto-Auswahl im Tool).
const artistMods = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/artists/*.{jpg,jpeg,png}',
  { eager: true },
);
const allPhotos = Object.entries(artistMods)
  .map(([path, mod]) => ({ file: path.split('/').pop()!, url: mod.default.src }))
  .sort((a, b) => a.file.localeCompare(b.file));

// Alle Sternformen (für die Stern-Auswahl).
const stars = STAR_SHAPE_KEYS.map((key) => ({
  key,
  mask: STAR_SHAPES[key].src.src,
  ratio: STAR_SHAPES[key].ratio,
}));

const fileForSrc = (src: string) =>
  allPhotos.find((p) => p.url === src)?.file ??
  src.split('?')[0].split('/').pop() ??
  '';

interface Photo {
  actId: string;
  key: string; // '' = Hauptfoto, '2' = zweites Foto (b2b)
  name: string;
  src: string;
  file: string;
  shapeKey: StarShape;
  mask: string; // URL der Stern-Silhouette (mask-image)
  starRatio: number; // Seitenverhältnis der Sternform
  focus: string;
  zoom: number;
}

// Default-Sternform zyklisch (wie Marquee/Highlights auf der Startseite).
let shapeIdx = 0;
function nextStarKey(): StarShape {
  const key = STAR_SHAPE_KEYS[shapeIdx % STAR_SHAPE_KEYS.length];
  shapeIdx++;
  return key;
}

const photos: Photo[] = [];
for (const a of acts) {
  const k1 = a.shape ?? nextStarKey();
  photos.push({
    actId: a.id,
    key: '',
    name: a.name,
    src: a.image.src,
    file: fileForSrc(a.image.src),
    shapeKey: k1,
    mask: STAR_SHAPES[k1].src.src,
    starRatio: STAR_SHAPES[k1].ratio,
    focus: a.focus ?? 'center',
    zoom: a.zoom ?? 1,
  });
  if (a.image2) {
    const k2 = a.shape2 ?? nextStarKey();
    photos.push({
      actId: a.id,
      key: '2',
      name: `${a.name} · Foto 2`,
      src: a.image2.src,
      file: fileForSrc(a.image2.src),
      shapeKey: k2,
      mask: STAR_SHAPES[k2].src.src,
      starRatio: STAR_SHAPES[k2].ratio,
      focus: a.focus2 ?? 'center',
      zoom: a.zoom2 ?? 1,
    });
  }
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Foto-Positionierer · FLINTA*SIALAND</title>
    <style>
      :root {
        --berry: #5d3e51;
        --mint: #edf5ed;
        --green: #7a8b48;
        --pink: #dc95bb;
        --line: #d6cdd2;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, sans-serif;
        background: var(--mint);
        color: var(--berry);
        padding: 2rem 1.5rem 6rem;
      }
      h1 { font-size: 1.5rem; margin: 0 0 .25rem; }
      .lede { margin: 0 0 2rem; max-width: 46rem; color: #6b5560; line-height: 1.5; }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.75rem;
      }
      .card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1rem;
      }
      .card h2 { font-size: 1rem; margin: 0 0 .1rem; }
      .card .id { font-size: .75rem; color: #9a8792; margin: 0 0 .75rem; font-family: ui-monospace, monospace; }
      .frame {
        position: relative;
        width: 100%;
        cursor: grab;
        touch-action: none;
        user-select: none;
      }
      .frame.dragging { cursor: grabbing; }
      /* Stern-Maske clippt die (ggf. gezoomte) Bildebene — wie auf der Startseite. */
      .maskwrap {
        position: absolute;
        inset: 0;
        -webkit-mask: var(--mask) no-repeat center / 100% 100%;
        mask: var(--mask) no-repeat center / 100% 100%;
        background: #eee;
      }
      .frame img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
      }
      /* Fadenkreuz-Markierung des Fokuspunkts */
      .frame .cross {
        position: absolute;
        width: 22px; height: 22px;
        margin: -11px 0 0 -11px;
        border: 2px solid #fff;
        border-radius: 50%;
        box-shadow: 0 0 0 1.5px rgba(0,0,0,.45), 0 0 6px rgba(0,0,0,.4);
        pointer-events: none;
      }
      .controls { margin-top: .85rem; }
      .row { display: flex; align-items: center; gap: .5rem; margin-top: .5rem; font-size: .8rem; }
      .row label { width: 3.2rem; color: #6b5560; }
      .row input[type=range] { flex: 1; accent-color: var(--green); }
      .row select {
        flex: 1;
        font: inherit;
        font-size: .78rem;
        padding: .2rem .3rem;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #fff;
        color: var(--berry);
      }
      .row output { width: 3rem; text-align: right; font-family: ui-monospace, monospace; }
      .snippet {
        margin-top: .85rem;
        background: var(--berry);
        color: var(--mint);
        border-radius: 10px;
        padding: .6rem .7rem;
        font-family: ui-monospace, monospace;
        font-size: .72rem;
        line-height: 1.5;
        white-space: pre;
        overflow-x: auto;
      }
      .btn {
        margin-top: .6rem;
        font: inherit;
        font-size: .75rem;
        padding: .35rem .7rem;
        border: 1px solid var(--berry);
        background: transparent;
        color: var(--berry);
        border-radius: 999px;
        cursor: pointer;
      }
      .btn:hover { background: var(--berry); color: var(--mint); }
      .global {
        position: sticky;
        bottom: 0;
        margin-top: 2.5rem;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1rem 1.25rem;
        box-shadow: 0 -8px 24px rgba(51,30,44,.12);
      }
      .global h2 { margin: 0 0 .5rem; font-size: 1rem; }
      .global textarea {
        width: 100%; height: 140px;
        font-family: ui-monospace, monospace; font-size: .72rem;
        border: 1px solid var(--line); border-radius: 10px; padding: .6rem;
        background: var(--mint); color: var(--berry);
      }
      .hint { font-size: .78rem; color: #6b5560; }
    </style>
  </head>
  <body>
    <h1>Foto-Positionierer</h1>
    <p class="lede">
      Ziehe im Bild, um den Ausschnitt zu setzen (das ist <code>focus</code> /
      object-position). Mit dem Zoom-Regler holst du das Gesicht näher heran.
      Die Vorschau zeigt die Stern-Maske wie auf der Startseite. Kopiere unten pro Act den
      Schnipsel in <code>src/content/acts.ts</code> — oder alles auf einmal im
      Kasten ganz unten.
    </p>

    <div class="grid" id="grid">
      {
        photos.map((p) => (
          <div
            class="card"
            data-act={p.actId}
            data-key={p.key}
            data-focus={p.focus}
            data-zoom={p.zoom}
            data-file={p.file}
            data-deffile={p.file}
            data-shape={p.shapeKey}
            data-defshape={p.shapeKey}
          >
            <h2>{p.name}</h2>
            <p class="id">{p.actId}{p.key === '2' ? ' · focus2/zoom2' : ''}</p>
            <div class="frame" style={`--mask: url("${p.mask}"); aspect-ratio: ${p.starRatio};`}>
              <div class="maskwrap">
                <img src={p.src} alt={p.name} draggable="false" />
              </div>
              <span class="cross"></span>
            </div>
            <div class="controls">
              <div class="row">
                <label>Foto</label>
                <select class="photo">
                  {allPhotos.map((ph) => (
                    <option value={ph.url} data-file={ph.file} selected={ph.url === p.src}>
                      {ph.file}
                    </option>
                  ))}
                </select>
              </div>
              <div class="row">
                <label>Stern</label>
                <select class="shape">
                  {stars.map((st) => (
                    <option
                      value={st.mask}
                      data-ratio={st.ratio}
                      data-key={st.key}
                      selected={st.key === p.shapeKey}
                    >
                      Form {st.key}
                    </option>
                  ))}
                </select>
              </div>
              <div class="row">
                <label>Zoom</label>
                <input type="range" class="zoom" min="1" max="2.5" step="0.05" value={p.zoom} />
                <output class="zoomval">{p.zoom.toFixed(2)}</output>
              </div>
            </div>
            <div class="snippet"></div>
            <button class="btn copy">Schnipsel kopieren</button>
          </div>
        ))
      }
    </div>

    <div class="global">
      <h2>Alle Werte (zum Abgleich)</h2>
      <p class="hint">
        Pro Zeile: Act-<code>id</code> → <code>focus</code>/<code>zoom</code>.
        Trage die Werte beim passenden Act in <code>acts.ts</code> ein.
      </p>
      <textarea id="allout" readonly></textarea>
    </div>

    <script>
      type Card = HTMLDivElement;

      /** "center 35%" → {x,y} in Prozent. */
      function parseFocus(str: string): { x: number; y: number } {
        const words: Record<string, number> = { left: 0, top: 0, center: 50, right: 100, bottom: 100 };
        const parts = (str || 'center').trim().split(/\s+/);
        const val = (tok: string, fallback: number) => {
          if (tok == null) return fallback;
          if (tok in words) return words[tok];
          const m = /^(-?\d+(?:\.\d+)?)%$/.exec(tok);
          return m ? parseFloat(m[1]) : fallback;
        };
        if (parts.length === 1) return { x: val(parts[0], 50), y: 50 };
        return { x: val(parts[0], 50), y: val(parts[1], 50) };
      }

      /** {x,y} → kompakter object-position-String ("center 35%"). */
      function fmtFocus(x: number, y: number): string {
        const fx = Math.round(x);
        const fy = Math.round(y);
        const sx = fx === 50 ? 'center' : `${fx}%`;
        const sy = fy === 50 ? 'center' : `${fy}%`;
        if (sx === 'center' && sy === 'center') return 'center';
        return `${sx} ${sy}`;
      }

      function snippetFor(card: Card): string {
        const id = card.dataset.act!;
        const key = card.dataset.key!;
        const x = parseFloat(card.dataset.x!);
        const y = parseFloat(card.dataset.y!);
        const zoom = parseFloat(card.dataset.zoom!);
        const fKey = key === '2' ? 'focus2' : 'focus';
        const zKey = key === '2' ? 'zoom2' : 'zoom';
        const imgKey = key === '2' ? 'image2' : 'image';
        const lines = [`// ${id}`];
        const shKey = key === '2' ? 'shape2' : 'shape';
        if (card.dataset.file !== card.dataset.deffile)
          lines.push(`// ${imgKey} → Datei '${card.dataset.file}' (Import in acts.ts anpassen)`);
        lines.push(`${fKey}: '${fmtFocus(x, y)}',`);
        if (zoom > 1.001) lines.push(`${zKey}: ${zoom.toFixed(2)},`);
        if (card.dataset.shape !== card.dataset.defshape)
          lines.push(`${shKey}: '${card.dataset.shape}',`);
        return lines.join('\n');
      }

      const cards = Array.from(document.querySelectorAll<HTMLDivElement>('.card'));
      const allout = document.getElementById('allout') as HTMLTextAreaElement;

      function render(card: Card) {
        const img = card.querySelector('img') as HTMLImageElement;
        const cross = card.querySelector('.cross') as HTMLElement;
        const frame = card.querySelector('.frame') as HTMLElement;
        const x = parseFloat(card.dataset.x!);
        const y = parseFloat(card.dataset.y!);
        const zoom = parseFloat(card.dataset.zoom!);
        img.style.objectPosition = `${x}% ${y}%`;
        img.style.scale = String(zoom);
        img.style.transformOrigin = `${x}% ${y}%`;
        cross.style.left = `${(x / 100) * frame.clientWidth}px`;
        cross.style.top = `${(y / 100) * frame.clientHeight}px`;
        (card.querySelector('.snippet') as HTMLElement).textContent = snippetFor(card);
      }

      function renderAll() {
        const out: string[] = [];
        for (const card of cards) {
          const id = card.dataset.act!;
          const key = card.dataset.key!;
          const x = parseFloat(card.dataset.x!);
          const y = parseFloat(card.dataset.y!);
          const zoom = parseFloat(card.dataset.zoom!);
          const fKey = key === '2' ? 'focus2' : 'focus';
          const zKey = key === '2' ? 'zoom2' : 'zoom';
          let line = `${id.padEnd(20)} ${fKey}: '${fmtFocus(x, y)}'`;
          if (zoom > 1.001) line += `, ${zKey}: ${zoom.toFixed(2)}`;
          out.push(line);
        }
        allout.value = out.join('\n');
      }

      for (const card of cards) {
        const { x, y } = parseFocus(card.dataset.focus || 'center');
        card.dataset.x = String(x);
        card.dataset.y = String(y);

        const frame = card.querySelector('.frame') as HTMLElement;
        const img = card.querySelector('img') as HTMLImageElement;
        const zoomInput = card.querySelector('.zoom') as HTMLInputElement;
        const zoomVal = card.querySelector('.zoomval') as HTMLOutputElement;
        const photoSel = card.querySelector('.photo') as HTMLSelectElement;
        const shapeSel = card.querySelector('.shape') as HTMLSelectElement;

        // Foto wählen — Bildquelle tauschen.
        photoSel.addEventListener('change', () => {
          const opt = photoSel.selectedOptions[0];
          card.dataset.file = opt.dataset.file!;
          img.src = photoSel.value;
          render(card);
        });

        // Genderstern wählen — Maske + Seitenverhältnis tauschen.
        shapeSel.addEventListener('change', () => {
          const opt = shapeSel.selectedOptions[0];
          card.dataset.shape = opt.dataset.key!;
          frame.style.setProperty('--mask', `url("${shapeSel.value}")`);
          frame.style.aspectRatio = opt.dataset.ratio!;
          render(card);
        });

        // Ziehen = Ausschnitt verschieben.
        let dragging = false;
        let startX = 0, startY = 0, baseX = 0, baseY = 0;
        frame.addEventListener('pointerdown', (e) => {
          dragging = true;
          frame.classList.add('dragging');
          frame.setPointerCapture(e.pointerId);
          startX = e.clientX; startY = e.clientY;
          baseX = parseFloat(card.dataset.x!);
          baseY = parseFloat(card.dataset.y!);
        });
        frame.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          const dx = (e.clientX - startX) / frame.clientWidth * 100;
          const dy = (e.clientY - startY) / frame.clientHeight * 100;
          // Bild in Ziehrichtung → mehr von der Gegenseite zeigen.
          const nx = Math.min(100, Math.max(0, baseX - dx));
          const ny = Math.min(100, Math.max(0, baseY - dy));
          card.dataset.x = String(nx);
          card.dataset.y = String(ny);
          render(card);
          renderAll();
        });
        const stop = (e: PointerEvent) => {
          if (!dragging) return;
          dragging = false;
          frame.classList.remove('dragging');
          try { frame.releasePointerCapture(e.pointerId); } catch {}
        };
        frame.addEventListener('pointerup', stop);
        frame.addEventListener('pointercancel', stop);

        zoomInput.addEventListener('input', () => {
          card.dataset.zoom = zoomInput.value;
          zoomVal.textContent = parseFloat(zoomInput.value).toFixed(2);
          render(card);
          renderAll();
        });

        (card.querySelector('.copy') as HTMLButtonElement).addEventListener('click', () => {
          navigator.clipboard?.writeText(snippetFor(card));
        });

        render(card);
      }

      renderAll();
      // Fadenkreuz nach Layout/Resize neu setzen.
      window.addEventListener('resize', () => cards.forEach(render));
    </script>
  </body>
</html>
