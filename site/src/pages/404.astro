---
/**
 * 404 — Fallback für nicht gefundene Routen.
 *
 * Astro rendert src/pages/404.astro automatisch für unbekannte Pfade
 * (im Dev-Server sowie bei statischen Hosts wie GitHub Pages, die 404.html
 * ausliefern). Bewusst schlicht: klare Ansage + Weg zurück zur Startseite.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
import { texte, pick } from '@content/texte';
import { localeFromPath } from '@lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = texte.notFound;
---

<BaseLayout
  title={pick(t.metaTitle, locale)}
  description={pick(t.metaDescription, locale)}
>
  <Section theme="light" spacing="lg" class="pt-28 md:pt-32">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
        {pick(t.kicker, locale)}
      </p>
      <Heading level={1} size="lg" class="mt-3">{pick(t.headline, locale)}</Heading>
      <p class="mt-5 text-on-surface-muted">
        {pick(t.body, locale)}
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <Button href="/">{pick(t.ctaHome, locale)}</Button>
        <Button href="/line-up" variant="outline">{pick(t.ctaLineup, locale)}</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
