---
/**
 * FlintasiaMark — Logo des Flinta*sia Kollektivs („FLINTA*SIA“ + Unterzeile).
 *
 * Analog zu `LogoMark`: das SVG wird inline eingebettet und auf
 * `fill: currentColor` gesetzt, damit es die Textfarbe der Theme-Zone erbt.
 * Wird bewusst nur an einzelnen Stellen verwendet (z. B. Impressum), nicht als
 * Standard-Markenlogo der Seiten.
 */
import raw from '@assets/logo/logo-flintasia-berry.svg?raw';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// XML/Doctype entfernen, feste width/height streichen (Skalierung via CSS),
// die fixe Berry-Füllung auf currentColor mappen (erbt die Zonen-Textfarbe).
const svg = raw
  .replace(/<\?xml[\s\S]*?\?>/, '')
  .replace(/<!DOCTYPE[\s\S]*?>/, '')
  .replace(/<svg([^>]*?)\swidth="[^"]*"/, '<svg$1')
  .replace(/<svg([^>]*?)\sheight="[^"]*"/, '<svg$1')
  .replace(/fill:\s*#673b50/gi, 'fill: currentColor')
  .replace('<svg', '<svg fill="currentColor" role="img" aria-label="FLINTA*SIA Kollektiv"');
---

<span class:list={['flintasia-mark inline-flex', className]} set:html={svg} />

<style>
  .flintasia-mark :global(svg) {
    display: block;
    height: 100%;
    width: auto;
  }
</style>
