---
/**
 * Footer — dark-Zone. Impressum/Datenschutz-Platzhalter, Social, Kontakt,
 * Hinweis aufs Kollektiv (Vorbereitung fürs spätere /kollektiv).
 */
import { Image } from 'astro:assets';
import logoMint from '@assets/logo/logo-light-mint.svg';
import { footerLinks, contactEmail } from '@lib/site';
import { t } from '@lib/i18n';

const year = new Date().getFullYear();
---

<footer data-theme="dark" class="bg-surface text-on-surface">
  <div class="u-container grid gap-10 py-14 md:grid-cols-[1.5fr_1fr_1fr] md:py-16">
    <!-- Brand -->
    <div>
      <Image src={logoMint} alt="Flinta*sialand" class="h-11 w-auto" />
      <p class="mt-4 max-w-xs text-on-surface-muted">{t.footer.madeWith}</p>
    </div>

    <!-- Rechtliches -->
    <nav aria-label={t.footer.imprint}>
      <h2 class="font-display text-sm font-bold uppercase tracking-wide text-accent">
        Info
      </h2>
      <ul class="mt-4 space-y-2">
        {
          footerLinks.legal.map((link) => (
            <li>
              <a href={link.href} class="text-on-surface/90 hover:text-accent">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Kontakt / Social -->
    <div>
      <h2 class="font-display text-sm font-bold uppercase tracking-wide text-accent">
        {t.footer.contact}
      </h2>
      <ul class="mt-4 space-y-2">
        <li>
          <a href={`mailto:${contactEmail}`} class="text-on-surface/90 hover:text-accent">
            {contactEmail}
          </a>
        </li>
        {
          footerLinks.social.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-on-surface/90 hover:text-accent"
              >
                {link.label}
                <span class="sr-only"> — {t.a11y.externalLink}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-hairline">
    <div
      class="u-container flex flex-col gap-2 py-6 text-sm text-on-surface-muted md:flex-row md:items-center md:justify-between"
    >
      <p>© {year} Flinta*sia Kollektiv</p>
      <p>{t.footer.collective}</p>
    </div>
  </div>
</footer>
