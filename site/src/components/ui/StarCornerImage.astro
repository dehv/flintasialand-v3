---
/**
 * StarCornerImage — Bild-Behandlung Konzept 2 (editorial, pflegeleicht).
 *
 * Das Bild bleibt rechteckig (beste Lesbarkeit für inhaltslastige Grids wie
 * Line-Up-Liste oder News). An einer Ecke sitzt ein solider Genderstern in
 * Akzentfarbe, der leicht über die Kante lappt. Ruhiger als die Vollmaske.
 *
 * Sternform (`shape`), Akzent (`accent`), Ecke (`corner`) und Größe wählbar.
 * Der Eck-Stern wird als eingefärbte Maske gerendert (Alpha aus dem PNG, Farbe
 * aus CI-Token) → CI-treu und frei kombinierbar.
 *
 * @example
 * <StarCornerImage src={actImg} alt="DJ Foo" corner="tr" accent="pink" />
 */
import { Image } from 'astro:assets';
import { getStar, resolveAccent, type StarShape, type StarAccent } from '@lib/sterne';

type Corner = 'tl' | 'tr' | 'bl' | 'br';

interface Props {
  /** Lokales Bild (optimiert) oder URL-String (z. B. aus dem CMS). */
  src: ImageMetadata | string;
  alt: string;
  /** Bild-Seitenverhältnis (CSS aspect-ratio). */
  ratio?: string;
  /** Sternform '1'–'4' des Eck-Sterns. */
  shape?: StarShape;
  /** Akzentfarbe des Eck-Sterns. 'auto' = Zonen-Akzent. */
  accent?: StarAccent;
  /** In welcher Ecke der Stern sitzt. */
  corner?: Corner;
  /** Bildausschnitt (CSS object-position), um Gesichter im Fokus zu halten. */
  focus?: string;
  /** Zoom-Faktor (1 = kein Zoom). Skaliert das Bild um den Fokuspunkt. */
  zoom?: number;
  /** Sterngröße als Anteil der Bildbreite (0–1). */
  starSize?: number;
  /** Abgerundete Bildecken. */
  rounded?: boolean;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  ratio = '4 / 5',
  shape = '2',
  accent = 'pink',
  corner = 'br',
  focus = 'center',
  zoom = 1,
  starSize = 0.4,
  rounded = true,
  eager = false,
  sizes = '(min-width: 768px) 33vw, 90vw',
  class: className,
} = Astro.props;

const star = getStar(shape);
const accentColor = resolveAccent(accent) ?? 'var(--accent)';

const style = [
  `--star-mask: url("${star.src.src}")`,
  `--star-accent: ${accentColor}`,
  `--star-size: ${(starSize * 100).toFixed(2)}%`,
  `--star-ratio: ${star.ratio}`,
  `--img-ratio: ${ratio}`,
  `--img-focus: ${focus}`,
  `--img-zoom: ${zoom}`,
].join('; ');
---

<figure
  class:list={['star-corner', rounded && 'star-corner--rounded', className]}
  data-corner={corner}
  style={style}
>
  <div class="star-corner__frame">
    {
      typeof src === 'string' ? (
        <img
          class="star-corner__img"
          src={src}
          alt={alt}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <Image
          class="star-corner__img"
          src={src}
          alt={alt}
          sizes={sizes}
          widths={[320, 480, 640, 960]}
          loading={eager ? 'eager' : 'lazy'}
        />
      )
    }
  </div>
  <span class="star-corner__star" aria-hidden="true"></span>
</figure>

<style>
  .star-corner {
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    /* Platz, damit der überlappende Stern nicht abgeschnitten wird. */
    padding: calc(var(--star-size) * 0.28);
  }

  /* Rahmen clippt das (ggf. gezoomte) Bild; der Eck-Stern liegt außerhalb und
     bleibt unbeschnitten. */
  .star-corner__frame {
    aspect-ratio: var(--img-ratio);
    overflow: hidden;
  }

  .star-corner--rounded .star-corner__frame {
    border-radius: var(--radius-md);
  }

  .star-corner__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--img-focus, center);
    scale: var(--img-zoom, 1);
    transform-origin: var(--img-focus, center);
  }

  .star-corner__star {
    position: absolute;
    width: var(--star-size);
    aspect-ratio: var(--star-ratio);
    background: var(--star-accent);
    -webkit-mask: var(--star-mask) no-repeat center / 100% 100%;
    mask: var(--star-mask) no-repeat center / 100% 100%;
    pointer-events: none;
  }

  /* Ecke positionieren: Stern lappt ~ ein Viertel seiner Größe über die Kante. */
  .star-corner[data-corner='tl'] .star-corner__star {
    top: 0;
    left: 0;
  }
  .star-corner[data-corner='tr'] .star-corner__star {
    top: 0;
    right: 0;
  }
  .star-corner[data-corner='bl'] .star-corner__star {
    bottom: 0;
    left: 0;
  }
  .star-corner[data-corner='br'] .star-corner__star {
    bottom: 0;
    right: 0;
  }
</style>
