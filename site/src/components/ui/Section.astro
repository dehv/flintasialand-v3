---
/**
 * Section — eine umschaltbare "Theme-Zone".
 *
 * Setzt data-theme="dark|light" und damit die semantischen Farbrollen
 * (surface/on-surface/accent). Kindkomponenten müssen die Zone nicht kennen —
 * sie nutzen einfach `bg-surface`, `text-on-surface`, `text-accent` etc. und
 * ziehen automatisch die CI-treue Farbe für den jeweiligen Kontext.
 *
 * Redaktion kann pro Block ein `theme` wählen; Layout/Farblogik bleibt fix.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  theme?: 'dark' | 'light';
  /** Ankerziel für die One-Pager-Navigation. */
  id?: string;
  /** Vertikales Padding. 'none' für randlose Blöcke (z. B. Hero). */
  spacing?: 'none' | 'sm' | 'md' | 'lg';
  /** Inneren Container (max-width + Padding) automatisch setzen. */
  container?: boolean;
  as?: 'section' | 'div' | 'header' | 'footer' | 'article';
}

const {
  theme = 'light',
  id,
  spacing = 'lg',
  container = true,
  as: Tag = 'section',
  class: className,
  ...rest
} = Astro.props;

const spacingClass = {
  none: '',
  sm: 'py-8 md:py-10',
  md: 'py-12 md:py-16',
  lg: 'py-16 md:py-24',
}[spacing];
---

<Tag
  data-theme={theme}
  id={id}
  class:list={[
    'bg-surface text-on-surface transition-colors',
    spacingClass,
    className,
  ]}
  {...rest}
>
  {
    container ? (
      <div class="u-container">
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</Tag>
