---
/**
 * Sticky-Navbar im "Solid-Pill"-Stil (Referenz: favoriten-festival.de).
 * Jedes Nav-Item ist eine solide Pille. Aktuelle Route = invertierte/Akzent-Pille.
 *
 * Desktop: Pillen-Reihe. Mobil: "Menü"-Pille -> gestapeltes, rechtsbündiges
 * Pillen-Overlay. Minimales Vanilla-JS nur fürs Toggle — kein Framework.
 *
 * Die Navbar ist bewusst eine dark-Zone (berry Bar): mint-Pillen mit berry-Text
 * sind darauf immer gut lesbar, egal über welcher Sektion die Bar klebt.
 */
import { primaryNav } from '@lib/site';
import { t } from '@lib/i18n';

// TODO: Ticket-Link von Alia; bis dahin ausgeblendet.
const ticketHref = '';

const path = Astro.url.pathname;
/** Aktiv nur für echte Routen (Anker-Items auf dem One-Pager nie „aktiv"). */
function isActive(href: string, anchor?: boolean): boolean {
  if (anchor) return false;
  const clean = href.replace(/\/$/, '');
  return path === href || path === clean || path.startsWith(clean + '/');
}

// Pillen-Stile. Kein Balken -> Schatten trennt die Pillen vom Hintergrund,
// damit sie auch über hellen Sektionen lesbar bleiben. Feste CI-Farben.
const pillShadow = 'shadow-[0_2px_12px_rgba(51,30,44,0.28)]';
const pillBase =
  'inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 font-display text-sm font-bold whitespace-nowrap transition-colors focus-visible:outline-berry ' +
  pillShadow;
const pillIdle = 'bg-mint text-berry hover:bg-accent-teal';
const pillActive = 'bg-accent-teal text-berry';
const pillTicket = 'bg-accent-teal text-berry hover:bg-mint';
---

<!-- Kein Balken, kein Logo: floatende Pillen oben rechts. pointer-events-none
     auf dem Wrapper, damit der transparente Bereich Klicks auf den Hero durchlässt;
     nur die Pillen selbst sind klickbar. -->
<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <nav
    aria-label={t.nav.menu}
    class="u-container flex items-center justify-end gap-4 py-3 md:py-4"
  >
    <!-- Desktop: Pillen-Reihe -->
    <ul class="pointer-events-auto hidden items-center gap-2 lg:flex">
      {
        primaryNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href, item.anchor) ? 'page' : undefined}
              class:list={[
                pillBase,
                isActive(item.href, item.anchor) ? pillActive : pillIdle,
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      {
        ticketHref && (
          <li>
            <a href={ticketHref} class:list={[pillBase, pillTicket]}>
              {t.actions.tickets}
            </a>
          </li>
        )
      }
    </ul>

    <!-- Mobil: "Menü"-Pille -->
    <button
      type="button"
      id="nav-toggle"
      class:list={[pillBase, pillIdle, 'pointer-events-auto lg:hidden']}
      aria-label={t.nav.open}
      aria-expanded="false"
      aria-controls="nav-panel"
    >
      <span data-label-open>{t.nav.menu}</span>
    </button>
  </nav>
</header>

<!-- Off-Canvas-Overlay (mobil). Außerhalb von <header>, damit der backdrop-blur
     keinen Containing-Block für das fixed-Overlay erzeugt. -->
<div
  id="nav-panel"
  data-theme="dark"
  hidden
  class="fixed inset-0 z-[60] overflow-y-auto bg-surface lg:hidden"
>
  <div class="u-container flex min-h-full flex-col items-end gap-3 py-4">
    <!-- Schließen-Pille -->
    <button
      type="button"
      id="nav-close"
      class:list={[pillBase, pillIdle]}
      aria-label={t.nav.close}
    >
      {t.nav.closeShort}
    </button>

    {
      primaryNav.map((item) => (
        <a
          href={item.href}
          data-nav-link
          aria-current={isActive(item.href, item.anchor) ? 'page' : undefined}
          class:list={[
            pillBase,
            'px-6 py-3 text-lg',
            isActive(item.href, item.anchor) ? pillActive : pillIdle,
          ]}
        >
          {item.label}
        </a>
      ))
    }
    {
      ticketHref && (
        <a
          href={ticketHref}
          data-nav-link
          class:list={[pillBase, pillTicket, 'px-6 py-3 text-lg']}
        >
          {t.actions.tickets}
        </a>
      )
    }
  </div>
</div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const closeBtn = document.getElementById('nav-close');
  const panel = document.getElementById('nav-panel');

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    // Scroll sperren, solange das Overlay offen ist.
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) closeBtn?.focus();
    else toggle.focus();
  }

  toggle?.addEventListener('click', () => setOpen(panel?.hidden ?? true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  panel
    ?.querySelectorAll('[data-nav-link]')
    .forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.hidden) setOpen(false);
  });

  // Beim Wechsel auf Desktop sicher zurücksetzen.
  window
    .matchMedia('(min-width: 1024px)')
    .addEventListener('change', (e) => e.matches && setOpen(false));
</script>
