---
/**
 * TimetableTeaser — Timetable-Teaser (light-Sektion).
 *
 * Zeigt einen kompakten Ausschnitt der Timetable (z. B. Startzeiten und Highlights
 * beider Bühnen) und verweist auf die vollständige Timetable-Route.
 */
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
import { timetable } from '@content/timetable';

// Für den Teaser zeigen wir nur die ersten paar Slots beider Bühnen
const teaserTimetable = timetable.map((stage) => ({
  ...stage,
  slots: stage.slots.slice(0, 4),
}));
---

<Section theme="light" id="timetable" spacing="lg">
  <div class="text-center">
    <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
      Timetable Preview
    </p>
    <Heading level={2} size="lg" class="mt-3">
      Wann läuft was?
    </Heading>
    <p class="mx-auto mt-4 max-w-2xl text-on-surface-muted">
      Zwei Bühnen, volles Programm. Hier ist eine kleine Vorschau auf den Ablauf des Festivals.
    </p>
  </div>

  <div class="mt-12 grid gap-10 md:grid-cols-2">
    {
      teaserTimetable.map((stage) => (
        <div class="rounded-2xl bg-surface-muted/50 p-6 md:p-8 ring-1 ring-hairline">
          <h3 class="font-display text-xl font-bold tracking-tight text-accent border-b border-hairline pb-4">
            {stage.stageName}
          </h3>
          <ul class="mt-4 divide-y divide-hairline">
            {stage.slots.map((slot) => (
              <li class="flex items-baseline justify-between gap-4 py-3">
                <span class="shrink-0 font-mono text-sm font-semibold tracking-tight text-accent">
                  {slot.time}
                </span>
                <span class="text-right font-display font-bold text-on-surface">
                  {slot.artist}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mt-12 text-center">
    <Button href="/timetable">Komplette Timetable ansehen</Button>
  </div>
</Section>
