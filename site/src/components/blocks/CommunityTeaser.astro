---
/**
 * CommunityTeaser — Teaser für Workshops & Community Space (light-Sektion).
 *
 * Verweist auf die /workshops-Seite (Workshops, Gewalten Formen, Queer Dating
 * Stage). Bild: Konzept-Rendering der „Gewalten Formen“-Installation.
 */
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
import StarCornerImage from '@ui/StarCornerImage.astro';
import imgGewaltenFormen from '@assets/workshops/gewalten-formen.png';
import { texte, pick } from '@content/texte';
import { localeFromPath } from '@lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = texte.communityTeaser;
---

<Section theme="light" id="community" spacing="lg" class="border-t border-hairline">
  <div class="grid items-center gap-8 md:grid-cols-12">
    <div class="md:col-span-5 md:order-last">
      <StarCornerImage
        src={imgGewaltenFormen}
        alt="„Gewalten Formen“ — Konzept der mobilen, künstlerisch-politischen Installation im Community Space"
        ratio="4 / 5"
        shape="4"
        accent="pink"
        corner="bl"
        focus="50% 45%"
      />
      <p class="mt-3 text-xs text-on-surface-muted">
        {pick(t.credit, locale)}
      </p>
    </div>

    <div class="md:col-span-7">
      <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
        {pick(t.kicker, locale)}
      </p>
      <Heading level={2} size="lg" class="mt-3">
        {pick(t.headline, locale)}
      </Heading>
      <p class="mt-5 max-w-prose text-on-surface-muted" set:html={pick(t.body, locale)} />
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="/workshops">{pick(t.cta, locale)}</Button>
      </div>
    </div>
  </div>
</Section>
