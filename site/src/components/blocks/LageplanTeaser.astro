---
/**
 * LageplanTeaser — Lageplan-Teaser (light-Sektion).
 *
 * Zeigt einen kompakten Teaser der Location "Speicher 100" in Dortmund,
 * die Adresse und einen Button zur interaktiven /lageplan Route.
 */
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
import StarCornerImage from '@ui/StarCornerImage.astro';
import { lageplan } from '@content/lageplan';
import imgGelaende from '@assets/venue/gelaende.jpg';
import { texte, pick } from '@content/texte';
import { localeFromPath } from '@lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = texte.lageplanTeaser;
---

<Section theme="light" id="lageplan" spacing="lg" class="border-t border-hairline">
  <div class="grid items-center gap-8 md:grid-cols-12">
    <div class="md:col-span-7">
      <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
        {pick(t.kicker, locale)}
      </p>
      <Heading level={2} size="lg" class="mt-3">
        {pick(t.headline, locale)}
      </Heading>
      <p
        class="mt-5 max-w-prose text-on-surface-muted"
        set:html={pick(t.body, locale).replace('{ort}', lageplan.name)}
      />
      <div class="mt-6">
        <p class="font-display text-sm font-bold text-on-surface">{pick(t.addressLabel, locale)}</p>
        <p class="text-on-surface-muted">{lageplan.address}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="/lageplan">{pick(t.cta, locale)}</Button>
      </div>
    </div>
    
    <div class="md:col-span-5">
      <StarCornerImage
        src={imgGelaende}
        alt="FLINTA*SIALAND Festivalgelände am Speicher 100 — Publikum bei Sonnenuntergang"
        ratio="4 / 5"
        shape="2"
        accent="teal"
        corner="tr"
        focus="48% 42%"
      />
      <p class="mt-3 text-xs text-on-surface-muted">{pick(t.credit, locale)}</p>
    </div>
  </div>
</Section>
