---
/**
 * LageplanTeaser — Lageplan-Teaser (light-Sektion).
 *
 * Zeigt einen kompakten Teaser der Location "Speicher 100" in Dortmund,
 * die Adresse und einen Button zur interaktiven /lageplan Route.
 */
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
import { lageplan } from '@content/lageplan';
---

<Section theme="light" id="lageplan" spacing="lg" class="border-t border-hairline">
  <div class="grid items-center gap-8 md:grid-cols-12">
    <div class="md:col-span-7">
      <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
        Location & Gelände
      </p>
      <Heading level={2} size="lg" class="mt-3">
        Das Festivalgelände am Hafen
      </Heading>
      <p class="mt-5 max-w-prose text-on-surface-muted">
        Das FLINTA*SIALAND findet dieses Jahr im <strong>{lageplan.name}</strong> statt. 
        Mitten im Dortmunder Hafen/Nordstadt erwartet dich ein abwechslungsreiches Areal: 
        von Konzerten und DJ-Sets auf der Kieselwiese und in der Maschinerie bis hin zu Workshops und Ruhezonen.
      </p>
      <div class="mt-6">
        <p class="font-display text-sm font-bold text-on-surface">Adresse:</p>
        <p class="text-on-surface-muted">{lageplan.address}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="/lageplan">Lageplan & Anreise</Button>
      </div>
    </div>
    
    <div class="md:col-span-5">
      <div class="relative overflow-hidden rounded-2xl bg-berry p-8 text-mint shadow-xl ring-1 ring-white/15">
        <div class="absolute -right-16 -top-16 h-36 w-36 rounded-full bg-accent-teal/10 blur-xl"></div>
        <div class="absolute -bottom-16 -left-16 h-36 w-36 rounded-full bg-accent-pink/10 blur-xl"></div>
        
        <p class="font-mono text-xs font-bold uppercase tracking-widest text-accent-teal"> Geländeführer </p>
        <h3 class="mt-2 font-display text-xl font-bold tracking-tight">Was gibt es wo?</h3>
        
        <ul class="mt-6 space-y-4">
          <li class="flex items-start gap-3">
            <span class="mt-1 inline-block h-3.5 w-3.5 rounded-full bg-accent-teal ring-1 ring-black/10 shrink-0"></span>
            <div>
              <p class="font-display text-sm font-bold text-mint">Kieselwiese</p>
              <p class="text-xs text-mint/75">Live-Bühne am Kai & sonnige Areale zum Entspannen.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 inline-block h-3.5 w-3.5 rounded-full bg-accent-teal ring-1 ring-black/10 shrink-0"></span>
            <div>
              <p class="font-display text-sm font-bold text-mint">Maschinerie</p>
              <p class="text-xs text-mint/75">Indoor-Clubbereich für die elektronischen DJ-Sets.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 inline-block h-3.5 w-3.5 rounded-full bg-accent-teal ring-1 ring-black/10 shrink-0"></span>
            <div>
              <p class="font-display text-sm font-bold text-mint">Community Space</p>
              <p class="text-xs text-mint/75">Workshops, Stände, Austausch & Bar-Bereiche.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</Section>
