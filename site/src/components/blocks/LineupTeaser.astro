---
/**
 * LineupTeaser — Line-Up-Teaser (dark-Sektion).
 *
 * Zeigt eine Auswahl der Acts (Highlight-Künstler*innen) als Stern-maskierte
 * Portraits mit Genre-Angabe und Link zur vollen Liste.
 */
import Section from '@ui/Section.astro';
import Heading from '@ui/Heading.astro';
import Button from '@ui/Button.astro';
import StarMaskedImage from '@ui/StarMaskedImage.astro';
import { acts } from '@content/acts';
import type { StarShape, StarAccent } from '@lib/sterne';

const highlightActs = acts.filter(act => act.highlight).slice(0, 4);

// Abwechselnde Formen und Akzente für das dynamische Layout
const layouts: { shape: StarShape; accent: StarAccent }[] = [
  { shape: '1', accent: 'teal' },
  { shape: '4', accent: 'pink' },
  { shape: '2', accent: 'teal' },
  { shape: '3', accent: 'pink' },
];
---

<Section theme="dark" id="lineup" spacing="lg">
  <div class="text-center">
    <p class="font-display text-sm font-bold uppercase tracking-widest text-accent">
      Line-Up
    </p>
    <Heading level={2} size="lg" class="mt-3">
      Erste Acts bestätigt!
    </Heading>
    <p class="mx-auto mt-4 max-w-2xl text-on-surface-muted">
      Von treibenden Live-Performances bis hin zu tiefen elektronischen DJ-Sets — 
      hier sind die ersten Künstler*innen für das Flinta*sialand 2026.
    </p>
  </div>

  <div class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4">
    {
      highlightActs.map((act, index) => {
        const layout = layouts[index % layouts.length];
        return (
          <div class="group flex flex-col items-center text-center">
            <div class="w-full overflow-hidden transition-transform duration-500 group-hover:scale-[1.03]">
              <StarMaskedImage
                src={act.image}
                alt={act.name}
                shape={layout.shape}
                accent={layout.accent}
              />
            </div>
            <h3 class="mt-4 font-display text-lg font-bold tracking-tight">
              {act.name}
            </h3>
            <p class="mt-1 text-xs font-medium uppercase tracking-wider text-accent">
              {act.genre}
            </p>
          </div>
        );
      })
    }
  </div>

  <div class="mt-16 text-center">
    <Button href="/line-up">Komplettes Line-Up entdecken</Button>
  </div>
</Section>
