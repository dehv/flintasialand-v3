---
/**
 * TimetableGrid — Zeitplan mit gemeinsamer Zeitachse.
 *
 * Beide Bühnen teilen sich EINE vertikale Zeitachse: gleiche Uhrzeit liegt auf
 * gleicher Höhe. Jeder Act ist ein Block, dessen Höhe der Spieldauer entspricht.
 * Links laufen die Stundenmarken mit. So sieht man auf einen Blick, was
 * parallel läuft.
 *
 * Datenquelle: `content/timetable.ts`. Zeit-Strings ("15:00h - 16:15h",
 * "22:00h - 00:00h", "14:30h") werden hier robust geparst.
 */
import { timetable } from '@content/timetable';

const PX_PER_MIN = 1.7;

function toMin(t: string): number {
  const [h, m] = t.split(':').map(Number);
  return h * 60 + (m || 0);
}

interface Block {
  artist: string;
  label: string;
  start: number;
  end: number;
  point: boolean; // Zeitpunkt ohne Ende (z. B. Begrüßung)
}

function parse(time: string): { start: number; end: number; point: boolean; label: string } {
  const clean = time.replace(/h/gi, '').trim();
  const [a, b] = clean.split(/\s*[-–]\s*/);
  const start = toMin(a);
  let end = b ? toMin(b) : start;
  if (b && end <= start) end += 24 * 60; // über Mitternacht (00:00)
  const label = b ? `${a.trim()}–${b.trim()}` : a.trim();
  return { start, end, point: !b, label };
}

const columns = timetable.map((stage) => ({
  name: stage.stageName,
  slug: stage.stageSlug,
  blocks: stage.slots.map((s): Block => {
    const p = parse(s.time);
    return { artist: s.artist, label: p.label, start: p.start, end: p.end, point: p.point };
  }),
}));

// Gemeinsame Achse: früheste Start- bis späteste Endzeit.
const allBlocks = columns.flatMap((c) => c.blocks);
const START = Math.min(...allBlocks.map((b) => b.start));
const END = Math.max(...allBlocks.map((b) => b.end));
const totalH = (END - START) * PX_PER_MIN;

// Stundenmarken.
const firstHour = Math.ceil(START / 60);
const lastHour = Math.floor(END / 60);
const hours: { min: number; text: string }[] = [];
for (let h = firstHour; h <= lastHour; h++) {
  hours.push({ min: h * 60, text: `${String(h % 24).padStart(2, '0')}:00` });
}

const top = (min: number) => (min - START) * PX_PER_MIN;
const height = (b: Block) => Math.max((b.end - b.start) * PX_PER_MIN, b.point ? 40 : 40);
---

<div class="tt" style={`--tt-h: ${totalH}px`}>
  <!-- Zeitachse -->
  <div class="tt-axis" aria-hidden="true">
    {
      hours.map((h) => (
        <div class="tt-hour" style={`top: ${top(h.min)}px`}>
          <span>{h.text}</span>
        </div>
      ))
    }
  </div>

  <!-- Bühnenspalten -->
  {
    columns.map((col) => (
      <div class="tt-col" data-stage={col.slug}>
        <h3 class="tt-col__head">{col.name}</h3>
        <div class="tt-col__track">
          {hours.map((h) => (
            <div class="tt-line" style={`top: ${top(h.min)}px`} aria-hidden="true" />
          ))}
          {col.blocks.map((b) => (
            <div
              class:list={['tt-block', b.point && 'tt-block--point']}
              style={`top: ${top(b.start)}px; height: ${height(b)}px`}
            >
              <span class="tt-block__time">{b.label}</span>
              <span class="tt-block__artist">{b.artist}</span>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>

<p class="tt-note">Änderungen vorbehalten.</p>

<style>
  .tt {
    display: grid;
    grid-template-columns: 3.5rem repeat(2, 1fr);
    gap: 0.5rem;
    margin-top: 1rem;
  }

  /* Zeitachse links */
  .tt-axis {
    position: relative;
    height: calc(var(--tt-h) + 2.5rem);
    padding-top: 2.5rem; /* Höhe der Spaltenköpfe ausgleichen */
  }
  .tt-hour {
    position: absolute;
    left: 0;
    right: 0;
    transform: translateY(calc(2.5rem - 50%));
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent);
    text-align: right;
    padding-right: 0.25rem;
  }

  .tt-col {
    display: flex;
    flex-direction: column;
  }
  .tt-col__head {
    height: 2.5rem;
    display: flex;
    align-items: center;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    color: var(--color-accent);
    border-bottom: 2px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
  }
  .tt-col__track {
    position: relative;
    height: var(--tt-h);
    margin-top: 0.5rem;
  }

  /* Stundenlinien */
  .tt-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: color-mix(in srgb, var(--color-on-surface) 12%, transparent);
  }

  /* Act-Block */
  .tt-block {
    position: absolute;
    left: 0;
    right: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding: 0.4rem 0.6rem;
    border-radius: 10px;
    background: var(--color-accent);
    color: var(--color-accent-on);
    box-shadow: 0 1px 4px rgba(51, 30, 44, 0.18);
  }
  .tt-block--point {
    background: transparent;
    color: var(--color-on-surface-muted);
    box-shadow: none;
    border: 1px dashed color-mix(in srgb, var(--color-accent) 55%, transparent);
  }
  .tt-block__time {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    font-weight: 600;
    opacity: 0.9;
  }
  .tt-block__artist {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.1;
  }

  .tt-note {
    margin-top: 1.25rem;
    font-size: 0.8rem;
    color: var(--color-on-surface-muted);
  }

  /* Bühnen farblich trennen: Kieselwiese grün (Live), Maschinerie berry (DJ). */
  .tt-col[data-stage='maschinerie'] .tt-block:not(.tt-block--point) {
    background: var(--color-berry);
    color: var(--color-mint);
  }

  @media (max-width: 640px) {
    .tt {
      grid-template-columns: 2.8rem repeat(2, 1fr);
    }
    .tt-block__artist {
      font-size: 0.8rem;
    }
  }
</style>
