---
/**
 * AwarenessTeaser — Awareness-Teaser (dark-Sektion).
 *
 * Zeigt die Kernbotschaft des Awareness-Konzepts und verlinkt auf die vollen
 * Awareness- und Code-of-Conduct-Seiten. Visuell ruhig, aber mit klarer
 * Haltung: Sicherer Raum, Zero-Tolerance, Pronomen-Sticker.
 */
import Section from "@ui/Section.astro";
import Heading from "@ui/Heading.astro";
import Button from "@ui/Button.astro";
import StarBullet from "@ui/StarBullet.astro";
import { texte, pick } from "@content/texte";
import { localeFromPath } from "@lib/i18n";

const locale = localeFromPath(Astro.url.pathname);
const t = texte.awarenessTeaser;
const shapes = ["1", "2", "3"] as const;
---

<Section theme="dark" id="awareness" spacing="lg">
  <div class="grid items-center gap-12 md:grid-cols-12">
    <!-- Linke Spalte: Statement -->
    <div class="md:col-span-7">
      <p
        class="font-display text-sm font-bold uppercase tracking-widest text-accent"
      >
        {pick(t.kicker, locale)}
      </p>
      <Heading level={2} size="lg" class="mt-3">{pick(t.headline, locale)}</Heading>
      <p
        class="mt-5 max-w-prose text-on-surface-muted leading-relaxed"
        set:html={pick(t.body1, locale)}
      />
      <p class="mt-4 max-w-prose text-on-surface-muted leading-relaxed">
        {pick(t.body2, locale)}
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="/awareness">{pick(t.ctaConcept, locale)}</Button>
        <Button href="/code-of-conduct" variant="outline"
          >{pick(t.ctaCoc, locale)}</Button
        >
      </div>
    </div>

    <!-- Rechte Spalte: Awareness-Karte -->
    <div class="md:col-span-5">
      <div class="rounded-2xl bg-mint/10 p-6 md:p-8 ring-1 ring-mint/15">
        <h3 class="font-display text-lg font-bold text-accent">
          {pick(t.cardTitle, locale)}
        </h3>
        <ul class="mt-5 space-y-4">
          {
            t.items.map((item, i) => (
              <li class="flex items-start gap-3">
                <StarBullet shape={shapes[i % shapes.length]} size="1.05rem" class="mt-1" />
                <div>
                  <p class="font-display text-sm font-bold text-on-surface">
                    {pick(item.title, locale)}
                  </p>
                  <p class="mt-0.5 text-sm text-on-surface-muted">
                    {pick(item.text, locale)}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Section>
