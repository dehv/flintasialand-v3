---
/**
 * BaseLayout — Grundgerüst jeder Seite.
 * Enthält <head> (SEO/OG), Skip-Link, Navbar, <main>, Footer.
 */
import '@styles/global.css';
import Navbar from '@ui/Navbar.astro';
import Footer from '@ui/Footer.astro';
import WaberDefs from '@ui/WaberDefs.astro';
import LogoMark from '@ui/LogoMark.astro';
import { t } from '@lib/i18n';

interface Props {
  title?: string;
  description?: string;
  /** Pfad zum OG-Bild relativ zur Site-URL. */
  ogImage?: string;
  /** Navbar/Footer ausblenden (z. B. für Fehlerseiten). */
  bare?: boolean;
}

const {
  title,
  description = 'Flinta*sialand — ein Festival vom Flinta*sia Kollektiv. Musik, Awareness und Community.',
  ogImage = '/og-default.png',
  bare = false,
} = Astro.props;

const siteName = t.meta.siteName;
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} Festival`;
/**
 * Marken-Logo oben links auf allen Unterseiten (Startseite hat den Hero-Mark).
 * Bewusst `absolute` statt `fixed`: es sitzt am Seitenanfang und scrollt mit
 * weg — im Gegensatz zu den fixierten Navigations-Pillen.
 */
const showBrand = !bare && Astro.url.pathname !== '/';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Sharing (Stern-Motiv als OG-Bild). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#5d3e51" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">{t.nav.skipToContent}</a>
    <WaberDefs />
    {!bare && <Navbar />}
    {
      showBrand && (
        <div class="pointer-events-none absolute inset-x-0 top-0 z-40">
          <div class="u-container py-3 md:py-4">
            <a
              href="/"
              class="pointer-events-auto inline-flex text-berry transition-opacity hover:opacity-80"
              aria-label="Zur Startseite"
            >
              <LogoMark class="h-12 md:h-14" />
            </a>
          </div>
        </div>
      )
    }
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
