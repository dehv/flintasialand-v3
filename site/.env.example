# --- Flinta*sialand — Beispiel-Env ---
# Kopiere diese Datei nach `.env` und fülle die Werte.
# Die Seite läuft in v1 auch OHNE diese Werte (lokale Fixtures als Fallback).

# Öffentliche Domain (für Canonical-URLs, Sitemap, OG-Bilder)
SITE_URL="https://flintasialand.de"

# --- Storyblok (CMS) — erst ab Phase 6 nötig ---
# Preview- oder Public-Token aus dem Storyblok-Space.
STORYBLOK_TOKEN=""
# "draft" (Preview/Editor) oder "published" (Live).
STORYBLOK_VERSION="published"

# --- Karte (Lageplan) ---
# Freie OSM-Tiles brauchen i. d. R. KEINEN Key. Nur setzen, falls ein
# tile-Provider mit Key genutzt wird (z. B. MapTiler).
MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_TILE_KEY=""
